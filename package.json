    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^25.6.0",
        "eslint": "^10.2.0",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "globals": "^17.5.0",
        "ts-node": "^10.9.2",
        "ts-patch": "^3.3.0",
        "typescript": "^5.9.3",
